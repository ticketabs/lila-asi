#!/usr/bin/env python3
"""
asi-cli — Unified Command-Line Interface for Lila ASI v2.4 Cartridges (.asi)

Subcommands:
  asi-cli pack  <input.gguf> -o <output.asi> [--mmproj <mmproj.gguf>]
  asi-cli info  <model.asi>
  asi-cli run   <model.asi> -p "Prompt" [-n 256] [-t 2] [--temp 0.6] [--mode fast|balanced|exact]
  asi-cli chat  <model.asi> [-t 2] [--ctx 8192] [--mode fast|balanced|exact]
  asi-cli bench <model.asi> [-n 64] [-t 2] [--mode fast|balanced|exact]
"""

from __future__ import annotations

import argparse
import os
import subprocess
import sys
import time
from pathlib import Path

HERE = Path(__file__).resolve().parent
ROOT = HERE.parent
PY_DIR = ROOT / "python"
if PY_DIR.is_dir():
    sys.path.insert(0, str(PY_DIR))
else:
    # Running directly from repo tree
    REPO_SRC = HERE.parents[1]
    sys.path.insert(0, str(REPO_SRC))
    sys.path.insert(0, str(REPO_SRC / "engine" / "asi"))


def _load_sdk():
    try:
        from lila_asi import AsiRuntime, apply_asi_mode_preset, convert_gguf_to_asi_v2
        return AsiRuntime, apply_asi_mode_preset, convert_gguf_to_asi_v2
    except ImportError:
        from src.core.asi_backend import AsiRuntime, apply_asi_mode_preset
        from gguf_to_asi_v2 import convert_gguf_to_asi_v2
        return AsiRuntime, apply_asi_mode_preset, convert_gguf_to_asi_v2


def cmd_pack(args: argparse.Namespace) -> int:
    _, _, convert_gguf_to_asi_v2 = _load_sdk()
    gguf_path = Path(args.gguf).expanduser().resolve()
    out_path = Path(args.output).expanduser().resolve()
    mmproj = Path(args.mmproj).expanduser().resolve() if args.mmproj else None
    t0 = time.perf_counter()
    out = convert_gguf_to_asi_v2(gguf_path, out_path, mmproj_path=mmproj)
    dt = time.perf_counter() - t0
    sz_mib = out.stat().st_size / (1024.0 * 1024.0)
    print(f"[asi-cli] Packed {gguf_path.name} -> {out} ({sz_mib:.2f} MiB in {dt:.2f}s)")
    return 0


def cmd_info(args: argparse.Namespace) -> int:
    native_cli = HERE / "lila-asi-cli"
    if not native_cli.is_file():
        native_cli = HERE.parents[1] / "engine" / "lila-asi-cli"
    if native_cli.is_file() and os.access(native_cli, os.X_OK):
        return subprocess.call([str(native_cli), str(args.model), "--info"])
    AsiRuntime, _, _ = _load_sdk()
    rt = AsiRuntime(str(args.model), n_ctx=256, n_threads=1)
    try:
        cfg = rt._cfg
        print(f"ASI Cartridge : {args.model}")
        print(f"Engine        : {rt.runtime_label}")
        print(f"Layers        : {cfg.n_layers} (hidden={cfg.hidden_size}, intermediate={cfg.intermediate_size})")
        print(f"Attention     : heads={cfg.n_heads}, kv_heads={cfg.n_kv_heads}, head_dim={cfg.head_dim}")
        print(f"Vocabulary    : {cfg.vocab_size} tokens (max_seq_len={cfg.max_seq_len})")
        print(f"E05 Grammar   : {'supported' if getattr(rt, '_supports_e05', False) else 'off'}")
    finally:
        rt.close()
    return 0


def cmd_run(args: argparse.Namespace) -> int:
    AsiRuntime, apply_asi_mode_preset, _ = _load_sdk()
    apply_asi_mode_preset(args.mode)
    rt = AsiRuntime(str(args.model), n_ctx=args.ctx, n_threads=args.threads)
    try:
        messages = []
        if args.system:
            messages.append({"role": "system", "content": args.system})
        messages.append({"role": "user", "content": args.prompt})
        t0 = time.perf_counter()
        n_chunks = 0
        for ev in rt.create_chat_completion(
            messages,
            max_tokens=args.max_tokens,
            temperature=args.temp,
            stream=True,
        ):
            piece = ev["choices"][0]["delta"].get("content", "")
            if piece:
                sys.stdout.write(piece)
                sys.stdout.flush()
                n_chunks += 1
        dt = max(1e-6, time.perf_counter() - t0)
        sys.stdout.write("\n")
        print(f"\n[asi-cli] mode={args.mode} | chunks={n_chunks} | wall={dt:.2f}s ({n_chunks / dt:.2f} chunks/s)", file=sys.stderr)
    finally:
        rt.close()
    return 0


def cmd_chat(args: argparse.Namespace) -> int:
    AsiRuntime, apply_asi_mode_preset, _ = _load_sdk()
    apply_asi_mode_preset(args.mode)
    rt = AsiRuntime(str(args.model), n_ctx=args.ctx, n_threads=args.threads)
    messages = [{"role": "system", "content": args.system}]
    print(f"=== Lila ASI Interactive Chat ({rt.runtime_label}, ctx={args.ctx}) ===")
    print("Type 'exit' or Ctrl-D to quit.\n")
    try:
        while True:
            try:
                user_in = input("You > ").strip()
            except (EOFError, KeyboardInterrupt):
                print()
                break
            if not user_in:
                continue
            if user_in.lower() in {"exit", "quit", "/quit", "/exit"}:
                break
            messages.append({"role": "user", "content": user_in})
            sys.stdout.write("ASI > ")
            sys.stdout.flush()
            reply_parts = []
            for ev in rt.create_chat_completion(
                messages,
                max_tokens=args.max_tokens,
                temperature=args.temp,
                stream=True,
            ):
                piece = ev["choices"][0]["delta"].get("content", "")
                if piece:
                    sys.stdout.write(piece)
                    sys.stdout.flush()
                    reply_parts.append(piece)
            sys.stdout.write("\n\n")
            messages.append({"role": "assistant", "content": "".join(reply_parts)})
    finally:
        rt.close()
    return 0


def cmd_bench(args: argparse.Namespace) -> int:
    native_cli = HERE / "lila-asi-cli"
    if not native_cli.is_file():
        native_cli = HERE.parents[1] / "engine" / "lila-asi-cli"
    if native_cli.is_file() and os.access(native_cli, os.X_OK):
        return subprocess.call([
            str(native_cli),
            str(args.model),
            "--bench",
            "-t", str(args.threads),
            "-n", str(args.max_tokens),
            "--mode", args.mode,
        ])
    return cmd_run(args)


def main() -> int:
    ap = argparse.ArgumentParser(prog="asi-cli", description="Lila ASI v2.4 Standalone CLI")
    sub = ap.add_subparsers(dest="cmd", required=True)

    p_pack = sub.add_parser("pack", help="Convert a .gguf model into an .asi v2 cartridge")
    p_pack.add_argument("gguf", help="Input .gguf path")
    p_pack.add_argument("-o", "--output", required=True, help="Output .asi path")
    p_pack.add_argument("--mmproj", default=None, help="Optional vision projector .gguf")
    p_pack.set_defaults(func=cmd_pack)

    p_info = sub.add_parser("info", help="Inspect an .asi cartridge header, sections, and architecture")
    p_info.add_argument("model", help="Path to .asi cartridge")
    p_info.set_defaults(func=cmd_info)

    p_run = sub.add_parser("run", help="Run single-turn streaming generation on an .asi cartridge")
    p_run.add_argument("model", help="Path to .asi cartridge")
    p_run.add_argument("-p", "--prompt", required=True, help="User prompt")
    p_run.add_argument("-s", "--system", default="You are a helpful assistant.", help="System prompt")
    p_run.add_argument("-n", "--max-tokens", type=int, default=256, help="Max tokens to generate")
    p_run.add_argument("-t", "--threads", type=int, default=2, help="CPU threads")
    p_run.add_argument("--ctx", type=int, default=4096, help="Context window tokens")
    p_run.add_argument("--temp", type=float, default=0.0, help="Sampling temperature (0 = greedy)")
    p_run.add_argument("--mode", choices=["fast", "balanced", "exact"], default="fast", help="Engine preset")
    p_run.set_defaults(func=cmd_run)

    p_chat = sub.add_parser("chat", help="Interactive multi-turn chat with automatic session prefix reuse")
    p_chat.add_argument("model", help="Path to .asi cartridge")
    p_chat.add_argument("-s", "--system", default="You are a helpful assistant.", help="System prompt")
    p_chat.add_argument("-n", "--max-tokens", type=int, default=512, help="Max tokens per turn")
    p_chat.add_argument("-t", "--threads", type=int, default=2, help="CPU threads")
    p_chat.add_argument("--ctx", type=int, default=8192, help="Context window tokens")
    p_chat.add_argument("--temp", type=float, default=0.6, help="Sampling temperature")
    p_chat.add_argument("--mode", choices=["fast", "balanced", "exact"], default="fast", help="Engine preset")
    p_chat.set_defaults(func=cmd_chat)

    p_bench = sub.add_parser("bench", help="Run native prefill & decode speed benchmark")
    p_bench.add_argument("model", help="Path to .asi cartridge")
    p_bench.add_argument("-n", "--max-tokens", type=int, default=64, help="Decode tokens")
    p_bench.add_argument("-t", "--threads", type=int, default=2, help="CPU threads")
    p_bench.add_argument("--mode", choices=["fast", "balanced", "exact"], default="fast", help="Engine preset")
    p_bench.set_defaults(func=cmd_bench)

    args = ap.parse_args()
    return int(args.func(args))


if __name__ == "__main__":
    raise SystemExit(main())
